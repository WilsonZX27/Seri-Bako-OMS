    "lucide-react": "^0.468.0",
    "next": "^15.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.4.49",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
