# Copy to the ignored .env.preview.test.local only after an isolated Preview
# Supabase project and disposable role identities have been provisioned.
# Never point this fixture at Production or at the local Docker stack.
TEST_BASE_URL=https://<exact-preview-deployment>.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://<preview-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<preview-publishable-key>
RUN_PREVIEW_UAT=confirmed
EXPECTED_PREVIEW_APP_HOST=<exact-preview-deployment>.vercel.app
EXPECTED_PREVIEW_SUPABASE_PROJECT_REF=<preview-project-ref>

TEST_SUPER_ADMIN_EMAIL=<disposable-owner-email>
TEST_SUPER_ADMIN_PASSWORD=<disposable-owner-password>
TEST_PEOPLE_OPERATIONS_EMAIL=<disposable-people-operations-email>
TEST_PEOPLE_OPERATIONS_PASSWORD=<disposable-people-operations-password>
TEST_MANAGER_EMAIL=<disposable-manager-email>
TEST_MANAGER_PASSWORD=<disposable-manager-password>
TEST_PURCHASING_EMAIL=<disposable-purchasing-email>
TEST_PURCHASING_PASSWORD=<disposable-purchasing-password>
TEST_KITCHEN_EMAIL=<disposable-kitchen-email>
TEST_KITCHEN_PASSWORD=<disposable-kitchen-password>
TEST_FINANCE_EMAIL=<disposable-finance-email>
TEST_FINANCE_PASSWORD=<disposable-finance-password>
TEST_OUTLET_SUPERVISOR_EMAIL=<disposable-outlet-supervisor-email>
TEST_OUTLET_SUPERVISOR_PASSWORD=<disposable-outlet-supervisor-password>
TEST_OUTLET_EMAIL=<disposable-outlet-email>
TEST_OUTLET_PASSWORD=<disposable-outlet-password>
