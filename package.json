{
  "name": "seri-bako-ops",
  "version": "9.2.33",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prebuild": "node scripts/check-build-environment.mjs",
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "node --test tests/*.test.js",
    "test:contract": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:tenant-backup-local": "node --env-file=.env.test.local node_modules/@playwright/test/cli.js test tests/e2e/tenant-backup-isolation-local.spec.js --reporter=line",
    "test:gate2-owner-concurrency": "node scripts/gate2-owner-concurrency.mjs",
    "uat:guard": "node scripts/check-uat-environment.mjs",
    "uat:env:prepare": "node scripts/v9/prepare-local-uat-env.mjs",
    "uat:clone:prepare": "node scripts/v9/prepare-production-like-clone.mjs",
    "uat:clone:verify": "node scripts/v9/verify-production-like-clone.mjs",
    "uat:clone:destroy": "node scripts/v9/destroy-production-like-clone.mjs",
    "uat:v9:schema": "node scripts/v9/verify-local-schema.mjs",
    "uat:v9:local": "node scripts/v9/run-uat.mjs local",
    "uat:v9:full": "node scripts/v9/run-uat.mjs full",
    "uat:v9:preview": "node scripts/v9/run-uat.mjs preview --env .env.preview.test.local",
    "codex:orchestrate": "node tools/codex-orchestrator/cli.ts",
    "codex:orchestrator:test": "node --test tools/codex-orchestrator/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.1.11"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.4.49",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
